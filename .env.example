# Production MUST use apps-script. Local is development only.
DATA_PROVIDER=local
APP_URL=http://localhost:3000
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
SESSION_SECRET=
ADMIN_USERNAME=organiser
# Generate locally with npm run setup:local; use unique production credentials.
ADMIN_PASSWORD_HASH=
# Optional legacy Google Form for organiser imports. Website checkout is the primary registration flow.
VALORA_MUN_FORM_URL=
# Confirm draft matrices before import/registration operations.
VALORA_MUN_MATRIX_APPROVED=false
# Razorpay server-side keys. Never prefix secrets with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Publish your actual cancellation/refund policy; checkout stays closed until configured.
PAYMENT_REFUND_POLICY=
# Optional published Spline iframe URL; interactive native sculpture is the default.
SPLINE_SCENE_URL=
# Optional additional published scenes for the delegate kit and committee explorer.
SPLINE_EXPERIENCE_URL=
SPLINE_COMMITTEE_URL=
CONTACT_EMAIL=
EMAIL_PROVIDER=nodemailer
# Set to nodemailer to enable real transactional email and E-card attachments.
# Use a Workspace/Gmail app password or credentials from your SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Worker authentication; same value in Apps Script EMAIL_WORKER_SECRET.
CRON_SECRET=
# Apps Script EMAIL_WORKER_URL = https://your-domain/api/email/process

